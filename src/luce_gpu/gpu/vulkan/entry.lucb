#==============================================================================================
#
#   entry - Vulkan's entry points, found at run time
#
#   DESCRIPTION:
#       The system's Vulkan loader (libvulkan.so.1 on Linux, vulkan-1.dll on Windows) is
#       opened when the first device is, and every function below calls through the table it
#       fills. Nothing links against Vulkan, so building needs no Vulkan SDK or development
#       package, and a machine without Vulkan gets an error instead of a missing library.
#       Each function keeps the name and signature of the C one it stands for.
#
#==============================================================================================

extern func dlopen(file: c.str, mode: i32) -> void*?
extern func dlsym(handle: void*, name: c.str) -> void*?
extern func LoadLibraryW(name: u16*) -> void*?
extern func GetProcAddress(module: void*, name: c.str) -> void*?

struct VulkanFunctions:
    var vkCreateInstance: (func(VkInstanceCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroyInstance: (func(u64, void*?) -> unit)?
    var vkEnumeratePhysicalDevices: (func(u64, u32*?, u64*?) -> i32)?
    var vkGetPhysicalDeviceQueueFamilyProperties: (func(u64, u32*?, VkQueueFamilyProperties*?) -> unit)?
    var vkGetPhysicalDeviceMemoryProperties: (func(u64, VkPhysicalDeviceMemoryProperties*?) -> unit)?
    var vkGetPhysicalDeviceFormatProperties: (func(u64, u32, VkFormatProperties*?) -> unit)?
    var vkCreateDevice: (func(u64, VkDeviceCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroyDevice: (func(u64, void*?) -> unit)?
    var vkGetDeviceQueue: (func(u64, u32, u32, u64*?) -> unit)?
    var vkCreateWin32SurfaceKHR: (func(u64, VkWin32SurfaceCreateInfoKHR*?, void*?, u64*?) -> i32)?
    var vkGetPhysicalDeviceWin32PresentationSupportKHR: (func(u64, u32) -> u32)?
    var vkDestroySurfaceKHR: (func(u64, u64, void*?) -> unit)?
    var vkGetPhysicalDeviceSurfaceSupportKHR: (func(u64, u32, u64, u32*?) -> i32)?
    var vkGetPhysicalDeviceSurfaceCapabilitiesKHR: (func(u64, u64, VkSurfaceCapabilitiesKHR*?) -> i32)?
    var vkGetPhysicalDeviceSurfaceFormatsKHR: (func(u64, u64, u32*?, VkSurfaceFormatKHR*?) -> i32)?
    var vkCreateSwapchainKHR: (func(u64, VkSwapchainCreateInfoKHR*?, void*?, u64*?) -> i32)?
    var vkDestroySwapchainKHR: (func(u64, u64, void*?) -> unit)?
    var vkGetSwapchainImagesKHR: (func(u64, u64, u32*?, u64*?) -> i32)?
    var vkAcquireNextImageKHR: (func(u64, u64, u64, u64, u64, u32*?) -> i32)?
    var vkQueuePresentKHR: (func(u64, VkPresentInfoKHR*?) -> i32)?
    var vkQueueSubmit: (func(u64, u32, VkSubmitInfo*?, u64) -> i32)?
    var vkQueueWaitIdle: (func(u64) -> i32)?
    var vkDeviceWaitIdle: (func(u64) -> i32)?
    var vkCreateImageView: (func(u64, VkImageViewCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroyImageView: (func(u64, u64, void*?) -> unit)?
    var vkCreateImage: (func(u64, VkImageCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroyImage: (func(u64, u64, void*?) -> unit)?
    var vkGetImageMemoryRequirements: (func(u64, u64, VkMemoryRequirements*?) -> unit)?
    var vkAllocateMemory: (func(u64, VkMemoryAllocateInfo*?, void*?, u64*?) -> i32)?
    var vkFreeMemory: (func(u64, u64, void*?) -> unit)?
    var vkBindImageMemory: (func(u64, u64, u64, u64) -> i32)?
    var vkCreateBuffer: (func(u64, VkBufferCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroyBuffer: (func(u64, u64, void*?) -> unit)?
    var vkGetBufferMemoryRequirements: (func(u64, u64, VkMemoryRequirements*?) -> unit)?
    var vkBindBufferMemory: (func(u64, u64, u64, u64) -> i32)?
    var vkMapMemory: (func(u64, u64, u64, u64, u32, void*?*?) -> i32)?
    var vkUnmapMemory: (func(u64, u64) -> unit)?
    var vkCreateRenderPass: (func(u64, VkRenderPassCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroyRenderPass: (func(u64, u64, void*?) -> unit)?
    var vkCreateFramebuffer: (func(u64, VkFramebufferCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroyFramebuffer: (func(u64, u64, void*?) -> unit)?
    var vkCreateShaderModule: (func(u64, VkShaderModuleCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroyShaderModule: (func(u64, u64, void*?) -> unit)?
    var vkCreatePipelineLayout: (func(u64, VkPipelineLayoutCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroyPipelineLayout: (func(u64, u64, void*?) -> unit)?
    var vkCreateGraphicsPipelines: (func(u64, u64, u32, VkGraphicsPipelineCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroyPipeline: (func(u64, u64, void*?) -> unit)?
    var vkCreateCommandPool: (func(u64, VkCommandPoolCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroyCommandPool: (func(u64, u64, void*?) -> unit)?
    var vkAllocateCommandBuffers: (func(u64, VkCommandBufferAllocateInfo*?, u64*?) -> i32)?
    var vkResetCommandPool: (func(u64, u64, u32) -> i32)?
    var vkBeginCommandBuffer: (func(u64, VkCommandBufferBeginInfo*?) -> i32)?
    var vkEndCommandBuffer: (func(u64) -> i32)?
    var vkCmdBeginRenderPass: (func(u64, VkRenderPassBeginInfo*?, u32) -> unit)?
    var vkCmdEndRenderPass: (func(u64) -> unit)?
    var vkCmdBindPipeline: (func(u64, u32, u64) -> unit)?
    var vkCmdSetViewport: (func(u64, u32, u32, VkViewport*?) -> unit)?
    var vkCmdSetScissor: (func(u64, u32, u32, VkRect2D*?) -> unit)?
    var vkCmdBindVertexBuffers: (func(u64, u32, u32, u64*?, u64*?) -> unit)?
    var vkCmdDraw: (func(u64, u32, u32, u32, u32) -> unit)?
    var vkCreateSemaphore: (func(u64, VkSemaphoreCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroySemaphore: (func(u64, u64, void*?) -> unit)?
    var vkCreateFence: (func(u64, VkFenceCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroyFence: (func(u64, u64, void*?) -> unit)?
    var vkWaitForFences: (func(u64, u32, u64*?, u32, u64) -> i32)?
    var vkResetFences: (func(u64, u32, u64*?) -> i32)?
    var vkCreateDescriptorSetLayout: (func(u64, VkDescriptorSetLayoutCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroyDescriptorSetLayout: (func(u64, u64, void*?) -> unit)?
    var vkCreateDescriptorPool: (func(u64, VkDescriptorPoolCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroyDescriptorPool: (func(u64, u64, void*?) -> unit)?
    var vkAllocateDescriptorSets: (func(u64, VkDescriptorSetAllocateInfo*?, u64*?) -> i32)?
    var vkUpdateDescriptorSets: (func(u64, u32, VkWriteDescriptorSet*?, u32, VkCopyDescriptorSet*?) -> unit)?
    var vkCmdBindDescriptorSets: (func(u64, u32, u64, u32, u32, u64*?, u32, u32*?) -> unit)?
    var vkCmdPushConstants: (func(u64, u64, u32, u32, u32, void*?) -> unit)?
    var vkCreateSampler: (func(u64, VkSamplerCreateInfo*?, void*?, u64*?) -> i32)?
    var vkDestroySampler: (func(u64, u64, void*?) -> unit)?
    var vkCmdPipelineBarrier: (func(u64, u32, u32, u32, u32, void*?, u32, void*?, u32, VkImageMemoryBarrier*?) -> unit)?
    var vkCmdCopyBufferToImage: (func(u64, u64, u64, u32, u32, VkBufferImageCopy*?) -> unit)?
    var vkCmdCopyImageToBuffer: (func(u64, u64, u32, u64, u32, VkBufferImageCopy*?) -> unit)?
    var vkCreateXlibSurfaceKHR: (func(u64, VkXlibSurfaceCreateInfoKHR*?, void*?, u64*?) -> i32)?

var vulkan_functions: VulkanFunctions*? = none

## Open the system's Vulkan loader and find its functions, once. A function a
## platform's loader lacks (another platform's surface) stays unset and traps
## only if called.
func vulkan_load() -> !:
    if vulkan_functions != none:
        return
    let library = try vulkan_library()
    let table = try new VulkanFunctions() in memory.heap
    if let found = vulkan_symbol(library, "vkCreateInstance"):
        table.vkCreateInstance = (func(VkInstanceCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroyInstance"):
        table.vkDestroyInstance = (func(u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkEnumeratePhysicalDevices"):
        table.vkEnumeratePhysicalDevices = (func(u64, u32*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkGetPhysicalDeviceQueueFamilyProperties"):
        table.vkGetPhysicalDeviceQueueFamilyProperties = (func(u64, u32*?, VkQueueFamilyProperties*?) -> unit)found
    if let found = vulkan_symbol(library, "vkGetPhysicalDeviceMemoryProperties"):
        table.vkGetPhysicalDeviceMemoryProperties = (func(u64, VkPhysicalDeviceMemoryProperties*?) -> unit)found
    if let found = vulkan_symbol(library, "vkGetPhysicalDeviceFormatProperties"):
        table.vkGetPhysicalDeviceFormatProperties = (func(u64, u32, VkFormatProperties*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCreateDevice"):
        table.vkCreateDevice = (func(u64, VkDeviceCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroyDevice"):
        table.vkDestroyDevice = (func(u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkGetDeviceQueue"):
        table.vkGetDeviceQueue = (func(u64, u32, u32, u64*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCreateWin32SurfaceKHR"):
        table.vkCreateWin32SurfaceKHR = (func(u64, VkWin32SurfaceCreateInfoKHR*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkGetPhysicalDeviceWin32PresentationSupportKHR"):
        table.vkGetPhysicalDeviceWin32PresentationSupportKHR = (func(u64, u32) -> u32)found
    if let found = vulkan_symbol(library, "vkDestroySurfaceKHR"):
        table.vkDestroySurfaceKHR = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkGetPhysicalDeviceSurfaceSupportKHR"):
        table.vkGetPhysicalDeviceSurfaceSupportKHR = (func(u64, u32, u64, u32*?) -> i32)found
    if let found = vulkan_symbol(library, "vkGetPhysicalDeviceSurfaceCapabilitiesKHR"):
        table.vkGetPhysicalDeviceSurfaceCapabilitiesKHR = (func(u64, u64, VkSurfaceCapabilitiesKHR*?) -> i32)found
    if let found = vulkan_symbol(library, "vkGetPhysicalDeviceSurfaceFormatsKHR"):
        table.vkGetPhysicalDeviceSurfaceFormatsKHR = (func(u64, u64, u32*?, VkSurfaceFormatKHR*?) -> i32)found
    if let found = vulkan_symbol(library, "vkCreateSwapchainKHR"):
        table.vkCreateSwapchainKHR = (func(u64, VkSwapchainCreateInfoKHR*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroySwapchainKHR"):
        table.vkDestroySwapchainKHR = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkGetSwapchainImagesKHR"):
        table.vkGetSwapchainImagesKHR = (func(u64, u64, u32*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkAcquireNextImageKHR"):
        table.vkAcquireNextImageKHR = (func(u64, u64, u64, u64, u64, u32*?) -> i32)found
    if let found = vulkan_symbol(library, "vkQueuePresentKHR"):
        table.vkQueuePresentKHR = (func(u64, VkPresentInfoKHR*?) -> i32)found
    if let found = vulkan_symbol(library, "vkQueueSubmit"):
        table.vkQueueSubmit = (func(u64, u32, VkSubmitInfo*?, u64) -> i32)found
    if let found = vulkan_symbol(library, "vkQueueWaitIdle"):
        table.vkQueueWaitIdle = (func(u64) -> i32)found
    if let found = vulkan_symbol(library, "vkDeviceWaitIdle"):
        table.vkDeviceWaitIdle = (func(u64) -> i32)found
    if let found = vulkan_symbol(library, "vkCreateImageView"):
        table.vkCreateImageView = (func(u64, VkImageViewCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroyImageView"):
        table.vkDestroyImageView = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCreateImage"):
        table.vkCreateImage = (func(u64, VkImageCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroyImage"):
        table.vkDestroyImage = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkGetImageMemoryRequirements"):
        table.vkGetImageMemoryRequirements = (func(u64, u64, VkMemoryRequirements*?) -> unit)found
    if let found = vulkan_symbol(library, "vkAllocateMemory"):
        table.vkAllocateMemory = (func(u64, VkMemoryAllocateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkFreeMemory"):
        table.vkFreeMemory = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkBindImageMemory"):
        table.vkBindImageMemory = (func(u64, u64, u64, u64) -> i32)found
    if let found = vulkan_symbol(library, "vkCreateBuffer"):
        table.vkCreateBuffer = (func(u64, VkBufferCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroyBuffer"):
        table.vkDestroyBuffer = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkGetBufferMemoryRequirements"):
        table.vkGetBufferMemoryRequirements = (func(u64, u64, VkMemoryRequirements*?) -> unit)found
    if let found = vulkan_symbol(library, "vkBindBufferMemory"):
        table.vkBindBufferMemory = (func(u64, u64, u64, u64) -> i32)found
    if let found = vulkan_symbol(library, "vkMapMemory"):
        table.vkMapMemory = (func(u64, u64, u64, u64, u32, void*?*?) -> i32)found
    if let found = vulkan_symbol(library, "vkUnmapMemory"):
        table.vkUnmapMemory = (func(u64, u64) -> unit)found
    if let found = vulkan_symbol(library, "vkCreateRenderPass"):
        table.vkCreateRenderPass = (func(u64, VkRenderPassCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroyRenderPass"):
        table.vkDestroyRenderPass = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCreateFramebuffer"):
        table.vkCreateFramebuffer = (func(u64, VkFramebufferCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroyFramebuffer"):
        table.vkDestroyFramebuffer = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCreateShaderModule"):
        table.vkCreateShaderModule = (func(u64, VkShaderModuleCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroyShaderModule"):
        table.vkDestroyShaderModule = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCreatePipelineLayout"):
        table.vkCreatePipelineLayout = (func(u64, VkPipelineLayoutCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroyPipelineLayout"):
        table.vkDestroyPipelineLayout = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCreateGraphicsPipelines"):
        table.vkCreateGraphicsPipelines = (func(u64, u64, u32, VkGraphicsPipelineCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroyPipeline"):
        table.vkDestroyPipeline = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCreateCommandPool"):
        table.vkCreateCommandPool = (func(u64, VkCommandPoolCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroyCommandPool"):
        table.vkDestroyCommandPool = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkAllocateCommandBuffers"):
        table.vkAllocateCommandBuffers = (func(u64, VkCommandBufferAllocateInfo*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkResetCommandPool"):
        table.vkResetCommandPool = (func(u64, u64, u32) -> i32)found
    if let found = vulkan_symbol(library, "vkBeginCommandBuffer"):
        table.vkBeginCommandBuffer = (func(u64, VkCommandBufferBeginInfo*?) -> i32)found
    if let found = vulkan_symbol(library, "vkEndCommandBuffer"):
        table.vkEndCommandBuffer = (func(u64) -> i32)found
    if let found = vulkan_symbol(library, "vkCmdBeginRenderPass"):
        table.vkCmdBeginRenderPass = (func(u64, VkRenderPassBeginInfo*?, u32) -> unit)found
    if let found = vulkan_symbol(library, "vkCmdEndRenderPass"):
        table.vkCmdEndRenderPass = (func(u64) -> unit)found
    if let found = vulkan_symbol(library, "vkCmdBindPipeline"):
        table.vkCmdBindPipeline = (func(u64, u32, u64) -> unit)found
    if let found = vulkan_symbol(library, "vkCmdSetViewport"):
        table.vkCmdSetViewport = (func(u64, u32, u32, VkViewport*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCmdSetScissor"):
        table.vkCmdSetScissor = (func(u64, u32, u32, VkRect2D*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCmdBindVertexBuffers"):
        table.vkCmdBindVertexBuffers = (func(u64, u32, u32, u64*?, u64*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCmdDraw"):
        table.vkCmdDraw = (func(u64, u32, u32, u32, u32) -> unit)found
    if let found = vulkan_symbol(library, "vkCreateSemaphore"):
        table.vkCreateSemaphore = (func(u64, VkSemaphoreCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroySemaphore"):
        table.vkDestroySemaphore = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCreateFence"):
        table.vkCreateFence = (func(u64, VkFenceCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroyFence"):
        table.vkDestroyFence = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkWaitForFences"):
        table.vkWaitForFences = (func(u64, u32, u64*?, u32, u64) -> i32)found
    if let found = vulkan_symbol(library, "vkResetFences"):
        table.vkResetFences = (func(u64, u32, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkCreateDescriptorSetLayout"):
        table.vkCreateDescriptorSetLayout = (func(u64, VkDescriptorSetLayoutCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroyDescriptorSetLayout"):
        table.vkDestroyDescriptorSetLayout = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCreateDescriptorPool"):
        table.vkCreateDescriptorPool = (func(u64, VkDescriptorPoolCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroyDescriptorPool"):
        table.vkDestroyDescriptorPool = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkAllocateDescriptorSets"):
        table.vkAllocateDescriptorSets = (func(u64, VkDescriptorSetAllocateInfo*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkUpdateDescriptorSets"):
        table.vkUpdateDescriptorSets = (func(u64, u32, VkWriteDescriptorSet*?, u32, VkCopyDescriptorSet*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCmdBindDescriptorSets"):
        table.vkCmdBindDescriptorSets = (func(u64, u32, u64, u32, u32, u64*?, u32, u32*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCmdPushConstants"):
        table.vkCmdPushConstants = (func(u64, u64, u32, u32, u32, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCreateSampler"):
        table.vkCreateSampler = (func(u64, VkSamplerCreateInfo*?, void*?, u64*?) -> i32)found
    if let found = vulkan_symbol(library, "vkDestroySampler"):
        table.vkDestroySampler = (func(u64, u64, void*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCmdPipelineBarrier"):
        table.vkCmdPipelineBarrier = (func(u64, u32, u32, u32, u32, void*?, u32, void*?, u32, VkImageMemoryBarrier*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCmdCopyBufferToImage"):
        table.vkCmdCopyBufferToImage = (func(u64, u64, u64, u32, u32, VkBufferImageCopy*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCmdCopyImageToBuffer"):
        table.vkCmdCopyImageToBuffer = (func(u64, u64, u32, u64, u32, VkBufferImageCopy*?) -> unit)found
    if let found = vulkan_symbol(library, "vkCreateXlibSurfaceKHR"):
        table.vkCreateXlibSurfaceKHR = (func(u64, VkXlibSurfaceCreateInfoKHR*?, void*?, u64*?) -> i32)found
    if table.vkCreateInstance == none:
        free(table) in memory.heap
        error(unavailable, "the Vulkan loader has no vkCreateInstance")
    vulkan_functions = table

func vulkan_library() -> void*!:
    if platform.windows:
        var name: u16[13] = [118, 117, 108, 107, 97, 110, 45, 49, 46, 100, 108, 108, 0]
        return LoadLibraryW(&name[0]) else error(unavailable, "Vulkan is not installed (vulkan-1.dll)")
    # RTLD_NOW: every symbol is resolved at open.
    return dlopen("libvulkan.so.1", 2) else error(unavailable, "Vulkan is not installed (libvulkan.so.1)")

func vulkan_symbol(library: void*, name: c.str) -> void*?:
    if platform.windows:
        return GetProcAddress(library, name)
    return dlsym(library, name)

func vulkan_entry() -> VulkanFunctions*:
    return vulkan_functions else trap("Vulkan is used before it was loaded")

# mark: The functions ==========================================================================

func vkCreateInstance(pCreateInfo: VkInstanceCreateInfo*?, pAllocator: void*?, pInstance: u64*?) -> i32:
    let call = vulkan_entry().vkCreateInstance else trap("the Vulkan loader lacks vkCreateInstance")
    return call(pCreateInfo, pAllocator, pInstance)

func vkDestroyInstance(instance: u64, pAllocator: void*?):
    let call = vulkan_entry().vkDestroyInstance else trap("the Vulkan loader lacks vkDestroyInstance")
    call(instance, pAllocator)

func vkEnumeratePhysicalDevices(instance: u64, pPhysicalDeviceCount: u32*?, pPhysicalDevices: u64*?) -> i32:
    let call = vulkan_entry().vkEnumeratePhysicalDevices else trap("the Vulkan loader lacks vkEnumeratePhysicalDevices")
    return call(instance, pPhysicalDeviceCount, pPhysicalDevices)

func vkGetPhysicalDeviceQueueFamilyProperties(physicalDevice: u64, pQueueFamilyPropertyCount: u32*?, pQueueFamilyProperties: VkQueueFamilyProperties*?):
    let call = vulkan_entry().vkGetPhysicalDeviceQueueFamilyProperties else trap("the Vulkan loader lacks vkGetPhysicalDeviceQueueFamilyProperties")
    call(physicalDevice, pQueueFamilyPropertyCount, pQueueFamilyProperties)

func vkGetPhysicalDeviceMemoryProperties(physicalDevice: u64, pMemoryProperties: VkPhysicalDeviceMemoryProperties*?):
    let call = vulkan_entry().vkGetPhysicalDeviceMemoryProperties else trap("the Vulkan loader lacks vkGetPhysicalDeviceMemoryProperties")
    call(physicalDevice, pMemoryProperties)

func vkGetPhysicalDeviceFormatProperties(physicalDevice: u64, format_value: u32, pFormatProperties: VkFormatProperties*?):
    let call = vulkan_entry().vkGetPhysicalDeviceFormatProperties else trap("the Vulkan loader lacks vkGetPhysicalDeviceFormatProperties")
    call(physicalDevice, format_value, pFormatProperties)

func vkCreateDevice(physicalDevice: u64, pCreateInfo: VkDeviceCreateInfo*?, pAllocator: void*?, pDevice: u64*?) -> i32:
    let call = vulkan_entry().vkCreateDevice else trap("the Vulkan loader lacks vkCreateDevice")
    return call(physicalDevice, pCreateInfo, pAllocator, pDevice)

func vkDestroyDevice(device: u64, pAllocator: void*?):
    let call = vulkan_entry().vkDestroyDevice else trap("the Vulkan loader lacks vkDestroyDevice")
    call(device, pAllocator)

func vkGetDeviceQueue(device: u64, queueFamilyIndex: u32, queueIndex: u32, pQueue: u64*?):
