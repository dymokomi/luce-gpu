let mesh_id_frag_msl: c.str = "#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Parameters\n{\n    float4x4 clip;\n    float4x4 world;\n    float4x4 normal_matrix;\n    float4 tint;\n    float4 ambient;\n    float4 light_direction[4];\n    float4 light_color[4];\n    float4 eye;\n    float4 mode;\n    float4 zebra;\n    float4 zebra_axis;\n    float4 zebra_dark;\n    float4 zebra_light;\n    float4 line;\n    float4 accent;\n    float4 curvature;\n};\n\nstruct Triangles\n{\n    uint triangles[1];\n};\n\nstruct Corners\n{\n    uint corner_points[1];\n};\n\nstruct Positions\n{\n    float positions[1];\n};\n\nstruct Normals\n{\n    float normals[1];\n};\n\nstruct Colors\n{\n    float colors[1];\n};\n\nstruct Faces\n{\n    uint triangle_faces[1];\n};\n\nstruct Flags\n{\n    uint face_flags[1];\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nstruct luce_fragment_in\n{\n    uint face_id [[user(locn3)]];\n};\n\nfragment luce_fragment_out luce_fragment(luce_fragment_in in [[stage_in]], const device Parameters& p [[buffer(15)]])\n{\n    luce_fragment_out out = {};\n    uint id = (as_type<uint>(((device float*)&p.mode)[3u]) + in.face_id) + 1u;\n    out.fragment_color = float4(float(id & 255u), float((id >> 8u) & 255u), float((id >> 16u) & 255u), float(id >> 24u)) / float4(255.0);\n    return out;\n}\n\n"
