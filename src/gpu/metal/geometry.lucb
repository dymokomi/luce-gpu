## Immutable Metal buffer. Command buffers retain bound resources until complete.
func metal_geometry_create(device: MetalDevice*, vertices: const Vertex[]) -> void*!:
    return metal_buffer(metal_required(device.device), metal_sel("newBufferWithBytes:length:options:"), vertices.data, (u64)(vertices.length * memory.size_of(Vertex)), 0) else error(failed, "could not upload retained geometry")

func metal_geometry_release(device: void*, native: void*):
    metal_void(native, metal_sel("release"))

func metal_geometry_pipeline(device: MetalDevice*, drawing: MetalDrawing*, slot: usize) -> void*!:
    if let pipeline = drawing.geometry_pipelines[slot]: return pipeline
    if drawing.geometry_library == none:
        drawing.geometry_library = try metal_compile(metal_required(device.device), geometry_vert_msl, true)
    let pipeline = try metal_build_pipeline(device, drawing, metal_required(drawing.fill), Blend.over, slot, true)
    drawing.geometry_pipelines[slot] = pipeline
    return pipeline
