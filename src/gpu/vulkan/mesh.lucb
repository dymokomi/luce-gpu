#==============================================================================================
#
#   mesh - Vulkan buffers and mesh pipelines
#
#   DESCRIPTION:
#       Buffers are device-local storage filled by copies from the upload ring (or a staging
#       buffer of their own when larger), each followed by a barrier that makes the bytes
#       visible to every later submission (allocated and shared buffers: vulkan/compute.lucb). Mesh draws use
#       their own descriptor layout: storage buffers 8..14 and the parameter block at 15.
#
#==============================================================================================

struct VulkanBuffer:
    var buffer: u64
    var memory: u64
    var bytes: u64
    var last_use: u64
    ## A shared buffer's persistent mapping.
    var mapped: void*?

## Every buffer can be bound for storage, copied from and to, read as
## indirect dispatch arguments, and, where the device has them, addressed.
func vulkan_buffer_usage(device: VulkanDevice*) -> u32:
    var usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT
    if device.features.buffer_addresses: usage = usage | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT
    # Positions and indices a Blas is built from.
    if device.features.ray_query: usage = usage | VK_BUFFER_USAGE_ACCELERATION_STRUCTURE_BUILD_INPUT_READ_ONLY_BIT_KHR
    return usage

func vulkan_buffer_create(device: VulkanDevice*, data: const u8[]) -> VulkanBuffer*!:
    try vulkan_drawing(device)
    let state = try new VulkanBuffer(bytes = (u64)data.length) in memory.heap
    errdefer vulkan_buffer_release((void*)device, (void*)state)
    var info = VkBufferCreateInfo(sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, size = state.bytes, usage = vulkan_buffer_usage(device))
    try vulkan_check(vkCreateBuffer(device.device, &info, none, &state.buffer), "a Vulkan buffer could not be created")
    var requirements: VkMemoryRequirements
    vkGetBufferMemoryRequirements(device.device, state.buffer, &requirements)
    state.memory = try vulkan_buffer_memory(device, requirements, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)
    try vulkan_check(vkBindBufferMemory(device.device, state.buffer, state.memory, 0), "Vulkan buffer memory could not be bound")
    try vulkan_buffer_upload(device, state, 0, data)
    return state

## Copy `data` to `offset` on the queue: submissions before this one read the
## old bytes, later ones the new. It goes through the upload ring a slot's worth
## at a time, so a large upload allocates nothing of its own.
func vulkan_buffer_upload(device: VulkanDevice*, state: VulkanBuffer*, offset: usize, data: const u8[]) -> !:
    try vulkan_drawing(device)
    var done: usize = 0
    while done < data.length:
        let piece = canvas_min(data.length - done, (usize)vulkan_upload_slot_bytes)
        let room = try vulkan_upload_room(device, (u64)piece)
        let base = room.mapped else trap("a mapped Vulkan ring slot lost its mapping")
        memory.copy(u8[]((u8*)base + (usize)room.used, piece), data[done..<done + piece], piece)
        let source_offset = room.used
        room.used += (u64)piece
        let slot = try vulkan_begin(device)
        var region = VkBufferCopy(srcOffset = source_offset, dstOffset = (u64)(offset + done), size = (u64)piece)
        vkCmdCopyBuffer(slot.command, room.buffer, state.buffer, 1, &region)
        vulkan_compute_barrier(slot.command, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT)
        let serial = try vulkan_end(device, slot)
        state.last_use = serial
        room.serial = serial
        done += piece

## Release once every submission that read the buffer has completed.
func vulkan_buffer_release(raw_device: void*, raw_state: void*):
    let device = (VulkanDevice*)raw_device
    let state = (VulkanBuffer*)raw_state
    let item = VulkanRetired(kind = vulkan_retired_buffer, handle = state.buffer, allocation = VulkanAllocation(memory = state.memory))
    let serial = state.last_use
    free(state) in memory.heap
    vulkan_poll(device)
    if serial <= device.completed:
        vulkan_retired_free(device, item)
        return
    vulkan_retire(&device.slots[(usize)(serial % (u64)vulkan_slot_limit)], item) catch failure:
        vulkan_wait(device, serial) catch waited: _ = waited
        vulkan_retired_free(device, item)

# mark: Mesh pipelines ========================================================================

## The mesh descriptor layout, pipeline layout and placeholder buffer, made once.
func vulkan_mesh_ready(device: VulkanDevice*) -> !:
    if device.mesh_layout != 0:
        return
    var bindings: VkDescriptorSetLayoutBinding[8]
    for index in 0..<(usize)8:
        bindings[index] = VkDescriptorSetLayoutBinding(binding = (u32)index + 8, descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, descriptorCount = 1,
                                                       stageFlags = VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT)
    var descriptor_info = VkDescriptorSetLayoutCreateInfo(sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO, bindingCount = 8, pBindings = &bindings[0])
    try vulkan_check(vkCreateDescriptorSetLayout(device.device, &descriptor_info, none, &device.mesh_layout), "the Vulkan mesh layout could not be created")
    var layout_info = VkPipelineLayoutCreateInfo(sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO, setLayoutCount = 1, pSetLayouts = &device.mesh_layout)
    try vulkan_check(vkCreatePipelineLayout(device.device, &layout_info, none, &device.mesh_pipeline_layout), "the Vulkan mesh pipeline layout could not be created")
    var zeros: u8[16]
    device.mesh_placeholder = try vulkan_buffer_create(device, zeros)

func vulkan_mesh_destroy(device: VulkanDevice*):
    if let placeholder = device.mesh_placeholder:
        device.mesh_placeholder = none
        vulkan_buffer_release((void*)device, (void*)placeholder)
    if device.mesh_pipeline_layout != 0: vkDestroyPipelineLayout(device.device, device.mesh_pipeline_layout, none)
    if device.mesh_layout != 0: vkDestroyDescriptorSetLayout(device.device, device.mesh_layout, none)
    device.mesh_pipeline_layout = 0
    device.mesh_layout = 0

## The pipeline for `draw`'s variant (its kind; faded, no depth writes) in
## `formats`' passes, built on first use.
func vulkan_mesh_pipeline(device: VulkanDevice*, formats: VulkanFormatState*, draw: const MeshDraw*) -> u64!:
    try vulkan_mesh_ready(device)
    let kind = draw.kind
    let index = mesh_variant(draw)
    if formats.mesh[index] != 0:
        return formats.mesh[index]
    let vertex: const u32[] = mesh_wire_vert_words[..<mesh_wire_vert_words.length] if kind == MeshKind.wires else mesh_vert_words[..<mesh_vert_words.length]
    let fragment: const u32[] = mesh_id_frag_words[..<mesh_id_frag_words.length] if kind == MeshKind.ids else mesh_frag_words[..<mesh_frag_words.length]
    formats.mesh[index] = try vulkan_stage_pipeline(device, formats.pass_texture, vertex, fragment, device.mesh_pipeline_layout, Blend.replace if kind == MeshKind.ids else Blend.over, not mesh_faded(draw))
    return formats.mesh[index]

## Point `set` at the mesh draw's buffers and at its parameters in `upload`.
func vulkan_mesh_descriptors(device: VulkanDevice*, set: u64, draw: const MeshDraw*, upload: u64, parameters: u64) -> !:
    let placeholder = device.mesh_placeholder else trap("the Vulkan mesh placeholder is missing")
    var infos: VkDescriptorBufferInfo[8]
    var writes: VkWriteDescriptorSet[8]
    for index in 0..<(usize)7:
        var native = placeholder
        if let state = draw.buffers[index]: native = (VulkanBuffer*)state.native
        infos[index] = VkDescriptorBufferInfo(buffer = native.buffer, range = native.bytes)
    infos[7] = VkDescriptorBufferInfo(buffer = upload, offset = parameters, range = (u64)(mesh_parameter_count * 4))
    for index in 0..<(usize)8:
        writes[index] = VkWriteDescriptorSet(sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, dstSet = set, dstBinding = (u32)index + 8, descriptorCount = 1,
                                             descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, pBufferInfo = &infos[index])
    vkUpdateDescriptorSets(device.device, 8, &writes[0], 0, none)

## Record that submission `serial` reads the draw's buffers.
func vulkan_mesh_used(draw: const MeshDraw*, serial: u64):
    if serial == 0: return
    for buffer in draw.buffers:
        if let state = buffer: ((VulkanBuffer*)state.native).last_use = serial
