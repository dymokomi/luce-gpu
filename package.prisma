#prisma 4.0
def package "luce-gpu" {
    str owner = "dymokomi"
    str version = "0.5.1"
    str kind = "package"
    str language = "luce-base"
    str description = "GPU devices, textures, shaders and frames for Luce: Metal on macOS and Vulkan on Windows and Linux, presenting to luce-window windows."
    str readme = "README.md"
    str[] public = ["gpu"]

    def dependency "luce-std" {
        str owner = "dymokomi"
        str path = "../luce-std"
    }

    def dependency "luce-window" {
        str owner = "dymokomi"
        str path = "../luce-window"
    }

    def native "macos" {
        str[] libraries = ["objc"]
        str[] frameworks = ["Metal", "CoreGraphics", "QuartzCore"]
    }
}
