#version 450
#extension GL_EXT_nonuniform_qualifier : require
// Sample materials' textures through a texture table: each item names a slot.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Materials { uint slots[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Colors { vec4 colors[]; };
layout(set = 0, binding = 2) uniform sampler point;
layout(set = 1, binding = 0) uniform texture2D textures[];
layout(push_constant) uniform Params { uint n; } params;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n)
        return;
    colors[i] = textureLod(sampler2D(textures[nonuniformEXT(slots[i])], point), vec2(0.5), 0.0);
}
