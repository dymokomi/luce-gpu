#version 450
#extension GL_EXT_shader_atomic_float : require
// Every invocation adds its value to one float with atomicAdd.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Values { float values[]; };
layout(set = 0, binding = 1, std430) buffer Total { float total; };
layout(push_constant) uniform Params { uint n; } params;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < params.n)
        atomicAdd(total, values[i]);
}
