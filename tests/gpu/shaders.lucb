pub let tint_frag_msl: c.str = "#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Params\n{\n    float4 tint;\n    float4 rectangle;\n    float offset_scale;\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nstruct luce_fragment_in\n{\n    float4 vertex_color [[user(locn0)]];\n};\n\nfragment luce_fragment_out luce_fragment(luce_fragment_in in [[stage_in]], constant Params& params [[buffer(0)]], texture2d<float> first [[texture(1)]], texture2d<float> second [[texture(2)]], sampler firstSmplr [[sampler(1)]], sampler secondSmplr [[sampler(2)]], float4 gl_FragCoord [[position]])\n{\n    luce_fragment_out out = {};\n    float2 p = (gl_FragCoord.xy - params.rectangle.xy) / params.rectangle.zw;\n    float4 c = (in.vertex_color * params.tint) * first.sample(firstSmplr, p);\n    c.x += (second.sample(secondSmplr, p).x * params.offset_scale);\n    out.fragment_color = float4(c.xyz * c.w, c.w);\n    return out;\n}\n\n"
