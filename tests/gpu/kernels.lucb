pub let addresses_comp_msl: c.str = "#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Results;\nstruct Values;\n\nstruct Params\n{\n    device Results* results;\n    uint n;\n};\n\nstruct Results\n{\n    float results[1];\n};\n\nstruct Values\n{\n    float values[1];\n};\n\nstruct Table\n{\n    ulong sources[1];\n};\n\nconstant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(64u, 1u, 1u);\n\nkernel void luce_compute(constant Params& params [[buffer(30)]], device Table& _43 [[buffer(0)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])\n{\n    uint i = gl_GlobalInvocationID.x;\n    if (i >= params.n)\n    {\n        return;\n    }\n    device Values* source = reinterpret_cast<device Values*>(_43.sources[i % 2u]);\n    params.results->results[i] = source->values[i] * 2.0;\n}\n\n"
