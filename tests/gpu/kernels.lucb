pub let ieee_fast_comp_msl: c.str = "#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct In\n{\n    float zero;\n    float one;\n    float low;\n    float high;\n};\n\nstruct Out\n{\n    uint results[8];\n};\n\nconstant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(1u);\n\nkernel void luce_compute(device In& v [[buffer(0)]], device Out& o [[buffer(1)]])\n{\n    float positive = v.one / v.zero;\n    float negative = (-v.one) / v.zero;\n    float nan = v.zero / v.zero;\n    float near = fast::min(v.low / v.zero, v.high / v.zero);\n    float far = fast::max(v.low / v.zero, v.high / v.zero);\n    o.results[0] = as_type<uint>(positive);\n    o.results[1] = as_type<uint>(negative);\n    o.results[2] = uint(isnan(nan));\n    o.results[3] = uint(isinf(positive));\n    o.results[4] = uint(nan != nan);\n    o.results[5] = as_type<uint>(near);\n    o.results[6] = as_type<uint>(far);\n    o.results[7] = uint(isnan(v.zero * positive));\n}\n\n"
