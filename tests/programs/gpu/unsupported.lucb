from luce_gpu import gpu
from luce_window import window

pub func main(arguments: str[]) -> i32!:
    discard(arguments)
    assert(not gpu.supported())
    assert(not gpu.supported(gpu.Backend.metal))
    assert(not gpu.supported(gpu.Backend.vulkan))
    var rejected = false
    var device = gpu.Device.open() catch failure:
        assert(failure.code == gpu.unsupported)
        rejected = true
        recover gpu.Device()
    assert(rejected)
    device.destroy()
    var surface: gpu.Surface
    var host: window.Presentation
    surface.destroy()
    host.destroy()
    print("ok unsupported GPU target")
    return 0
